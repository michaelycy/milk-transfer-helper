{
  "name": "taro-milk-transfer-helper",
  "version": "1.0.0",
  "private": true,
  "description": "婴儿转奶助手 monorepo（小程序 + 管理后台 + 共享类型）",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:weapp": "pnpm --filter @milk-transfer/miniapp run dev:weapp",
    "dev:h5": "pnpm --filter @milk-transfer/miniapp run dev:h5",
    "dev:admin": "pnpm --filter @milk-transfer/admin run dev",
    "build:weapp": "pnpm --filter @milk-transfer/miniapp run build:weapp",
    "build:h5": "pnpm --filter @milk-transfer/miniapp run build:h5",
    "build:admin": "pnpm --filter @milk-transfer/admin run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test"
  }
}
