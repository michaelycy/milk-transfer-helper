# 本地/部署环境变量模板：复制为 .env 并填写
SUPABASE_URL=https://pncshxnordqrgrefcqwi.supabase.co
SUPABASE_ANON_KEY=填小程序在用的 anon key（apps/miniapp/.env 里有）
SUPABASE_SERVICE_ROLE_KEY=填 service_role key（Dashboard → Settings → API，勿泄露）
WECHAT_APPID=wx2e493d76e0d87cac
WECHAT_SECRET=小程序 AppSecret（mp.weixin.qq.com → 开发管理 → 开发设置）

# ---- AI 供应商密钥（FR-K1/K6）----
# 推荐方式：管理后台 → AI 配置 → 供应商 → 编辑里直接设置（加密落库，见下方主密钥）
# 以下环境变量为【可选兜底】：界面未设置某供应商密钥、或主密钥不可用时才会被使用；留空不影响启动
# 智谱 GLM（glm-4-flash / glm-4v-flash）：open.bigmodel.cn → API Keys
AI_ZHIPU_API_KEY=
# DeepSeek（deepseek-chat 等）：platform.deepseek.com → API Keys
AI_DEEPSEEK_API_KEY=
# 其他 OpenAI 兼容供应商（可选；自定义供应商亦可用 AI_<名称大写>_API_KEY 约定）
AI_OPENAI_API_KEY=

# ---- 界面密钥加密主密钥（FR-K6）：管理端设置 API Key 时必需，至少 16 位随机串 ----
# 生成示例：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 注意：更换主密钥将导致已存密钥不可解（自动回退环境变量密钥路径），请妥善保管
AI_KEY_MASTER_SECRET=
